!chatgpt_test.py
!save_som_images.py

!prompt/
!prompt/**

!fonts/
!fonts/**

!figs/
!figs/**

!utils/
!utils/**
utils/__pycache__/
utils/sam_utils/__pycache__/

!scripts/
